include AGENTS.md
include .gitattributes
include .gitignore
include CHANGELOG.md
include CONTRIBUTING.md
include LICENSE
include NOTICE
include README.md
include README.zh-CN.md
include ROADMAP.md
include SECURITY.md
include pyproject.toml
recursive-include .codex-plugin *.json
recursive-include .agents *.json
recursive-include .github *.yml *.md
recursive-include examples *.md *.py *.json *.yaml *.step
recursive-include docs *.md
recursive-include docs/site *.html *.css *.js *.svg
recursive-include docs/assets *.png *.svg
recursive-include tools *.py
include examples/gusseted-bracket/demo/index.html
include examples/gusseted-bracket/demo/style.css
include examples/gusseted-bracket/demo/demo.js
include examples/gusseted-bracket/demo/evidence.js
include examples/gusseted-bracket/demo/assets/geometry.png
include examples/gusseted-bracket/demo/assets/underside.png
include examples/gusseted-bracket/demo/assets/mesh.png
include examples/gusseted-bracket/demo/assets/total-deformation.png
include examples/gusseted-bracket/demo/assets/equivalent-stress.png
recursive-include docs/reports/evidence/2026-09-06 *.json
recursive-include schemas *.json
recursive-include skills *.md *.py *.yaml
recursive-include skills LICENSE
recursive-include tests *.py
recursive-include tests/fixtures *.md *.json *.yaml *.step
global-exclude __pycache__ *.py[cod]
global-exclude *.mechdb *.mechdat *.rst *.rth *.rdb *.db *.cdb *.dat *.out *.err *.full *.emat *.esav *.mode *.mntr *.dsdb *.wbpj *.wbpz
global-exclude ansyscl.* licdebug.*
global-exclude *.log junit*.xml release-preparation.md windows-acceptance-*.md
prune build
prune test-records
